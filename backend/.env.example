# Copy to backend/.env and supply your own credentials.
# Never commit backend/.env.
QLOO_API_KEY=replace_with_your_qloo_api_key
QLOO_API_BASE=replace_with_your_qloo_api_base_url
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=replace_with_supported_model_name

# Optional: set to a writable, persistent database path for deployment.
# EPIVIBE_DB_PATH=/absolute/path/to/epivibe.db
